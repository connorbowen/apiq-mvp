# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/apiq_mvp"

# Authentication (Custom JWT System)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Email Configuration (for verification and password reset emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@apiq.com"

# OpenAI Configuration
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# Confidence Configuration
CONFIDENCE_THRESHOLD=0.95

# Security Configuration
ENCRYPTION_KEY="your-32-character-encryption-key-here"
ENCRYPTION_MASTER_KEY="your-32-character-master-key-for-secrets-vault"
CORS_ORIGIN=http://localhost:3000
ADMIN_TOKEN="your-admin-token-here"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/apiq.log

# API Documentation Sync
API_DOC_SYNC_INTERVAL=86400000
API_DOC_SYNC_ENABLED=true

# OpenAPI Cache Configuration
OPENAPI_CACHE_TTL=3600
OPENAPI_CACHE_MAX_SIZE=100
OPENAPI_CACHE_MAX_SIZE_BYTES=52428800
OPENAPI_CACHE_COMPRESSION=true
OPENAPI_SLOW_SPEC_TIMEOUT=30000

# Test API Credentials (for development only)
STRIPE_TEST_SECRET_KEY="sk_test_your_stripe_test_key_here"

# OAuth2 Provider Configuration (for API connections)
# Google OAuth2 Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth2 Configuration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Microsoft Azure AD Configuration
AZURE_AD_CLIENT_ID="your-azure-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-client-secret"
AZURE_AD_TENANT_ID="your-azure-tenant-id"

# Okta Configuration
OKTA_CLIENT_ID="your-okta-client-id"
OKTA_CLIENT_SECRET="your-okta-client-secret"
OKTA_ISSUER="https://your-domain.okta.com"

# Generic OIDC Configuration
OIDC_CLIENT_ID="your-oidc-client-id"
OIDC_CLIENT_SECRET="your-oidc-client-secret"
OIDC_ISSUER="https://your-oidc-provider.com"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Secrets Vault Configuration
# Master key for encrypting all secrets (required)
ENCRYPTION_MASTER_KEY="your-32-character-master-key-for-secrets-vault"
# (Optional) Secondary encryption key for legacy or migration
ENCRYPTION_KEY="your-32-character-encryption-key-here"
# Enable health check endpoint for secrets vault (true/false)
SECRETS_VAULT_HEALTHCHECK_ENABLED=true
# Enable connection-secret validation (true/false)
SECRETS_CONNECTION_VALIDATION_ENABLED=true
# Enable automatic secrets rotation (true/false)
SECRETS_ROTATION_ENABLED=false
# Enable audit logging for all secrets operations (true/false)
SECRETS_AUDIT_LOGGING_ENABLED=true
# Enable monitoring/alerting for secrets vault (true/false)
SECRETS_VAULT_MONITORING_ENABLED=false

# Stripe Configuration (for SaaS billing)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Stripe Price IDs (for subscription plans)
STRIPE_STARTER_PRICE_ID="price_your_starter_price_id"
STRIPE_PROFESSIONAL_PRICE_ID="price_your_professional_price_id"
STRIPE_ENTERPRISE_PRICE_ID="price_your_enterprise_price_id"

# Stripe URLs (update with your domain)
STRIPE_SUCCESS_URL="http://localhost:3000/dashboard?tab=subscription&success=true"
STRIPE_CANCEL_URL="http://localhost:3000/dashboard?tab=subscription&cancelled=true"
NEXT_PUBLIC_STRIPE_SUCCESS_URL="http://localhost:3000/dashboard?tab=subscription&success=true"
NEXT_PUBLIC_STRIPE_CANCEL_URL="http://localhost:3000/dashboard?tab=subscription&cancelled=true"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Monitoring & Analytics (for enterprise features)
SENTRY_DSN="your-sentry-dsn-here"
DATADOG_API_KEY="your-datadog-api-key-here"

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
AI_CACHE_TTL=300
AI_CACHE_MAX_SIZE=1000

# AI Evaluation Framework
AI_EVAL_ENABLED=false
AI_EVAL_THRESHOLD=0.95
AI_EVAL_SAMPLE_SIZE=100

# Polling Service (for workflow triggers)
POLLING_ENABLED=true
POLLING_MAX_CONCURRENT=10
POLLING_DEFAULT_INTERVAL=300000

# Team Collaboration (for enterprise features)
TEAM_COLLABORATION_ENABLED=false
RBAC_ENABLED=false

# API Catalog (for shared API documentation)
API_CATALOG_ENABLED=false
API_CATALOG_SYNC_INTERVAL=86400000

# Usage Tracking & Billing
USAGE_TRACKING_ENABLED=true
BILLING_ENABLED=false
PLAN_LIMITS_ENABLED=false
